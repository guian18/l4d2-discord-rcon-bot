# Token de la aplicación/bot de Discord
DISCORD_TOKEN=

# Opcional: registra los comandos inmediatamente en un servidor concreto.
# Si se omite, se registran globalmente y Discord puede tardar en propagarlos.
DISCORD_GUILD_ID=

# Opcional pero recomendado: restringe el bot a un canal de administración.
DISCORD_CHANNEL_ID=

# Opcional pero recomendado: restringe el bot a un rol dedicado.
DISCORD_ADMIN_ROLE_ID=

# Dirección accesible DESDE EL HOST DEL BOT. No expongas RCON a Internet.
RCON_HOST=127.0.0.1
RCON_PORT=27015
RCON_PASSWORD=

# Longitud máxima del texto enviado como say.
MAX_MESSAGE_LENGTH=180

# Tiempo de espera de cada operación RCON, en milisegundos.
RCON_TIMEOUT_MS=3000
